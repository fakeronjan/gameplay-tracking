<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ronjan.gameplay-screenshots</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ronjan/code/fakeronjan/games/gameplay-tracking/.venv/bin/python</string>
        <string>/Users/ronjan/code/fakeronjan/games/gameplay-tracking/tools/sync_screenshots.py</string>
    </array>

    <!-- Daily at 9am, after the morning data update. A schedule rather than WatchPaths, since
         new screenshots land in subfolders the archive roots don't see. If the Mac is asleep
         at 9, it runs on wake. The script exits at once when nothing changed. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardErrorPath</key>
    <string>/Users/ronjan/code/fakeronjan/games/gameplay-tracking/local/sync.err.log</string>
</dict>
</plist>
